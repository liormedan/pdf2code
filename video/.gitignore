# Renders. Every file here is reproducible from src/ and audio/original/, and the masters
# are tens of megabytes.
out/

node_modules/

# Everything in public/ is derived, and `npm run setup` rebuilds all of it:
#   report.pdf         printed from assets/report.html by headless Chrome
#   pdf.mjs, worker    copied out of the app's own node_modules
#   audio/             the tightened takes, copied from ../audio
public/

# The tightened takes. tighten.mjs regenerates them from audio/original, which IS committed
# — those are the recordings, they cost credits, and no re-record is bit-identical.
audio/*.mp3

# Output of the converter, regenerated by npm run setup.
assets/converted-*
