{
  "name": "pdf2code-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pdf2code as an installed application. The shell — no conversion engine yet.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "npm run check:version && npm run check:credits && npm run typecheck && npm run test && npm run check:i18n && npm run check:a11y",
    "check:version": "node scripts/check-version.mjs",
    "check:credits": "node scripts/check-credits.mjs",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
