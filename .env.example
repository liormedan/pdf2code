# Copy to .env.local and set real values.
# ACCESS_CODE     shared access code (minimum 8 characters)
# SESSION_SECRET  random string signing the session cookie (minimum 32 characters)
#                 generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ACCESS_CODE=
SESSION_SECRET=

# Accounts. Required in production; local development can use the developer sign-in
# button instead, which skips both the access code and Firebase.
#   The NEXT_PUBLIC_ values are the Firebase web config. They are public by design —
#   they identify the project, they do not authorise anything.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
#   The service account is the opposite: it bypasses every security rule. Never prefix
#   it NEXT_PUBLIC. Base64 of the whole JSON key file, on one line:
#     node -e "console.log(require('fs').readFileSync('key.json').toString('base64'))"
FIREBASE_SERVICE_ACCOUNT=

# PowerPoint conversion. Off unless this is set to exactly "true", because it needs a
# server that can run LibreOffice — which rules out serverless hosting, both for the
# missing binary and for the request body cap. With it off the intake refuses .pptx and
# tells the user to export a PDF; PDF and Google Slides are unaffected.
NEXT_PUBLIC_ENABLE_PPTX=
# Where LibreOffice lives. Blank uses whatever `soffice` is on PATH.
SOFFICE_PATH=

# Google Slides import. Optional, and all three are required together — with any of them
# missing the button is not rendered at all. From a Google Cloud project with the Drive
# API and the Picker API enabled:
#   CLIENT_ID  OAuth 2.0 Web client, with this app's origin as an authorised JavaScript origin
#   API_KEY    an API key, used by the Picker
#   APP_ID     the project *number*, which is what grants a picked file to this app
# The scope requested is drive.file — one file at a time, chosen by the user in Google's
# own dialog. Deliberately not drive.readonly, which is a restricted scope and would put
# the app through Google verification and an annual security assessment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
