{
  "name": "pdf2code",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a PDF into HTML or a React component, entirely in the browser",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/sync-pdf-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-pdf-assets.mjs",
    "build": "next build",
    "start": "next start",
    "fixtures": "powershell -ExecutionPolicy Bypass -File scripts/fetch-fixtures.ps1",
    "bakeoff": "node scripts/serve-bakeoff.mjs",
    "analyze": "tsx scripts/analyze-fixtures.mjs",
    "test": "tsx scripts/test-converter.mjs",
    "validate": "tsx scripts/validate-output.mjs",
    "qa": "tsx scripts/qa.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "images": "tsx scripts/analyze-images.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.2",
    "html-validate": "^10.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
